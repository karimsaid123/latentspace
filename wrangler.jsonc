{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "latentspace",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": ".next",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "latentspace-db",
      "database_id": "YOUR_D1_DATABASE_ID_OPTIONAL"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
